# Cadova FollowUp — variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs.
# NE JAMAIS commit .env.local ou une clé réelle dans Git.

# --- Frontend (Vite — PUBLIC, expédiées dans le bundle browser) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Supabase Edge Functions (secrets SERVEUR uniquement) ---
# Configurer dans : Supabase → Settings → Edge Functions → Secrets
# Ces variables ne doivent JAMAIS avoir le préfixe VITE_ ni apparaître dans src/

# Clé API Resend pour l'envoi d'emails de rappel
RESEND_API_KEY=

# Adresse expéditrice vérifiée dans Resend
RESEND_FROM=Cadova <hello@votre-domaine.com>

# URL publique de l'application (liens dans les emails)
APP_URL=https://www.cadova.fr

# Origine des liens privés de suivi des devis
CADOVA_PUBLIC_URL=https://www.cadova.fr

# Signature du webhook Resend /functions/v1/resend-events
RESEND_WEBHOOK_SECRET=

# Sous-domaine de réception vérifié dans Resend (conserver les MX existants)
RESEND_RECEIVE_DOMAIN=

# Activer seulement après vérification du webhook et du DNS de réception
QUOTE_REPLY_EMAIL_ENABLED=false

# Relances automatiques aux clients : activer après vérification de Resend
# (Une activation explicite par devis reste obligatoire.)
QUOTE_FOLLOWUP_EMAIL_ENABLED=false

# Secret aléatoire réservé au planificateur Supabase, distinct des clés Auth
# Le script de déploiement le génère et le conserve côté serveur/Vault.
QUOTE_FOLLOWUP_SCHEDULER_SECRET=
